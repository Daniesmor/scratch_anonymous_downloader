lse,"topLevel":false},"H)`(WlSDWa~@a$SNe$_#":{"opcode":"looks_nextbackdrop","next":null,"parent":"PPn.`WC~FHv=t#]hfNs-","inputs":{},"fields":{},"shadow":false,"topLevel":false},"eyY5J#~A7eh4w:vmFEc1":{"opcode":"event_whenflagclicked","next":"%lAk?IiQgM80T%T6O[b{","parent":null,"inputs":{},"fields":{},"shadow":false,"topLevel":true,"x":386,"y":106},"%lAk?IiQgM80T%T6O[b{":{"opcode":"looks_show","next":"PAxW@J;5h*6SK[g;~cT-","parent":"eyY5J#~A7eh4w:vmFEc1","inputs":{},"fields":{},"shadow":false,"topLevel":false},"PAxW@J;5h*6SK[g;~cT-":{"opcode":"looks_switchcostumeto","next":null,"parent":"%lAk?IiQgM80T%T6O[b{","inputs":{"COSTUME":[1,"We7cY;s$+4VZJ/C]1IUj"]},"fields":{},"shadow":false,"topLevel":false},"We7cY;s$+4VZJ/C]1IUj":{"opcode":"looks_costume","next":null,"parent":"PAxW@J;5h*6SK[g;~cT-","inputs":{},"fields":{"COSTUME":["Lovebug",null]},"shadow":true,"topLevel":false}},"comments":{"Dag;v(h!W$Nxi6N|wcb!":{"blockId":null,"x":217.14814814814815,"y":365.962962962963,"width":290,"height":256,"minimized":false,"text":"NEON CYBORG:\nLemonFlowerPegasus // 20\nfantasticcreations // 4\nLeminoso // 14\nPuppypower44444 // 18\nDragonzLuvMe // 5\nThat_one_Miraidon // 2\n--_Hazelnut_-- // 26\nCatstronaut_//2\ncute-cat30 // 16"},"TD}yLdhM$jhcG6duP^YP":{"blockId":null,"x":-675,"y":397,"width":260.14813232421875,"height":121.40740966796875,"minimized":false,"text":"WTA entries:\nThe +1 and -1 things don't actually mean anything lol"},"evr8Oz0~2Hn}my6MRluA":{"blockId":null,"x":-269.81481481481484,"y":430.4074074074074,"width":419,"height":708,"minimized":false,"text":"@LemonFlowerPegasus \nBirdbrain Angel Entry: \nPronouns He/Him/They/Them(sometimes She/Her) \nOn the day with the brightest sun an egg began to crack. Many came to watch as the egg slowly opened to reveal a small Gryphon. The little Gryphlet tried to climb out of their egg, but fell over and landed on the ground. As they grew older the kids his age would always make fun of him, yelling BirdBrain repeatedly. After a while of this of this he decided to stand up to his bullies. He got them to follow him to the cliff by their home. “Look he’s gonna try to fly, Birdbrain!” they called out. He ignored them, unfolded his wings and stepped up to the cliff taking a deep breath. He got ready then jumped of the cliff, trying to flap his wings as he fell. He was about to hit the ground when he stopped falling and was flying! He flew back up and landed on the cliff again leaving the kids in awe.\nFrom then on BirdBrain wasn’t bad, it was good, it was him. Even though he may not be the smartest out of everyone he could fly, like a bird. He saw his flying as a gift he should share and helped those in need with it, earning his angel name, BirdBrain Angel"},"U1J=Y1XMN]EPp6z{.rV8":{"blockId":null,"x":368,"y":277,"width":413,"height":73,"minimized":false,"text":"This is where I am keeping track of all the tickets:"},"Tl3-=j(=cy6kceu_U_Ay":{"blockId":null,"x":532.5185185185186,"y":363,"width":307,"height":259,"minimized":false,"text":"LOVEBUG:\nmarenpup // 4\nZigZagWolf // 14\nMoirapicklesplz // 15\ncatlovedd // 20\nrxine-the-therixn // 2\n--Pumpkin_Pie-- // 9\nDragonQueenZ // 12\nGloryWingsofFireGlow// 8\nLava_Dragon123 // 9"},"JUi?UCD5.P0B{KmTr!(@":{"blockId":null,"x":-769,"y":547,"width":424,"height":950,"minimized":false,"text":"@JettTheDino\nBirdbrain Angel Entry: \n“In the midst of battle, an angel will rise,”\n\nIn the mystical realm of Eldoria, there lived a griffin angel named Lyra. Her radiant plumage shimmered like molten gold, and her eyes sparkled with the wisdom of the ages. With a guardian's noble heart and an eagle's graceful wings, Lyra was a wondrous sight to behold. A HARMONIUS land, Eldoria was home to all magical creatures, living in HARMONY under the benevolent rule of the Council of Ancients. However, tranquility was threatened when a malevolent sorcerer sought to plunge the realm into eternal darkness. As the dark clouds gathered and shadows crept across the land, fear spread like a plague, and despair loomed on the horizon. Lyra, ever so clever and compassionate, felt the unrest in the hearts of the creatures she had sworn to protect. With unwavering determination, she took to the skies, her melodious song resonating through the realm, carrying a message of hope and resilience. With each note, she infused the land with the power of courage, a reminder that the light within each being could overcome even the deepest darkness. As she journeyed through Eldoria, Lyra sought allies to stand against the encroaching evil. From the wise old oak spirits to the swift-winged faeries, she rallied a fellowship of brave souls willing to fight for the preservation of their home. Together, they formed an alliance as diverse as the colors of the sunrise, united in their quest to thwart the sorcerer's nefarious plans. In a climactic battle that shook the very foundations of Eldoria, Lyra and her companions confronted the dark sorcerer and his servants. With the strength of unity and the power of unwavering love, they vanquished the shadows that sought to consume their world. As the last echoes of evil faded, Eldoria basked once more in the warm embrace of harmony and light. From that day forth, Lyra and her companions were hailed as the legendary Guardians of Eldoria, revered for their bravery and selflessness. Their triumph served as a testament to the enduring spirit of unity and hope, a guiding light in times of turmoil for all who called Eldoria home."},"fWL/nj0fp)R%/@((^RES":{"blockId":null,"x":-1271.8148148148148,"y":547,"width":491.1053466796875,"height":1429.3701782226562,"minimized":false,"text":"@fantasticcreations (+1 for visuals of other characters, it's pretty cool you should do that)\nBirdbrain Angel Entry:\n(more being added?)\nName: Aksha, meaning blessing\nGender: Male\nPersonality: you'll see :P\nStory:\nBuckle up, people, cuz I have no idea what I'm doing XD\n\nPrologue\n\"where are you going?\" Quis jumped at the sound, whirling to find his little brother, Aksha, standing behind him. Talons, why was that little Griffon so silent?!\n\"not far,\" Quis lied, adjusting his bag on his shoulder. \"I'm just going to check on Dad. I'm sure everything's fine, but I thought it would still be a good idea to check.\" Aksha nodded, then paused before running up to his brother and wrapping his little, downy wings around him.\nQuis had to stop himself from pushing Aksha away. he didn't deserve his little brother's love. not after what would happen tonight.\n\"alright, I should go before it gets late,\" Quis finally said, a little more stiffly than he meant to. \"go get some sleep, Ak. your gonna need it.\" the little Griffon beamed, then yawned and started stumbling toward his nest.\nright before he curled up, Aksha hesitated, then looked up at his big brother. \"good night,\" he called brightly through another yawn. \"I love you, Quis.\"\nthe older Griffon's insides twisted. why did his little brother have to be so innocent? Quis could have walked away from a brat or if he'd been distant from Aksha, but\nhis little brother was like that. he never was.\n\"I... I love you too,\" Quis finally answered. it almost hurt to say it, even if it was true. probably because it was.\nAksha was curled up, and Quis wasn't even sure if he'd heard him. probably best if he hadn't.\nTaking one last look around, the dark brown Griffon adjusted his bag and slipped out of the cave.\nright before he dove into the woods, Quis looked back. 'this will probably be the last time I'm here,' he thought as he dove into the brush. 'at least for a while.'\nhe was right.\n\nChapter 1\nAksha woke to the sound of claws on stone. he groaned. Why was Cai always up so early? sometimes, Ak's cousin was the most annoying thing in the world. of course, sometimes he was Ak's saving grace, so he couldn't be complaining.\nAksha stretched, arching his back and fanning out his wings as Cai, a brightly colored Griffon with a twinkle of mischief in his eyes swaggered up.\n\"how do you live with such little sleep?\" Ak began preening his wings, spitting out a loose feather. \"you should be dead on your claws by now.\" \"how do you sleep through the Rising?\" Cai snipped, clacking his beak playfully. \"honestly, Ak, you'd sleep the whole world away if I didn't wake you up in the morning.\" \"I like it that way,\" Aksha grumbled, but shook himself and bounded toward the entry to their cave. \"usually you let me sleep a little longer. what day is it?\"\nwhen Cai didn't respond, Ak turned to see his cousin fiddling with his tail. \"oh.\" Ak couldn't think of anything else to say. it was The Day. Quis's day.\n\"did they...\"\n\"not yet,\" Cai promised. \"but... I don't know, Aksha.\n"},"_bOOXN_/U1i7k-j(@Gq6":{"blockId":null,"x":-1752,"y":547,"width":465,"height":742,"minimized":false,"text":"@ANTISKIBIDI2\nBirdbrain Angel Entry: \n(part 1) Likes: apples and the sky. Dislikes: large cats, commercial-size planes/vehicles. Backstory: Long ago..(like really long,) back in ancient Greece, Sparta, to be exact..two boys were fighting. They were soon to be sent off to a harsh school, which lasted many years, training them to be physically strong, and mentally sharp. And also it taught them battle skills. In sparta, fighting among boys was allowed, and even sometimes encouraged.\n\n (part 2) As well, stealing was encouraged. But you must not be caught, or you'd be punished greatly. One boy, blonde, five years old, who'd been punched, hard, and had fell, grabbed the other boy's leg, slipping him up, and darted for the Agora. There, he put on a stern look, and slowed hid walk. \"Hello.\" He waved at the merchants. But they were all much too distracted with the young boy charging at him, wondering what the blonde boy would do. Instead of clenching his fists, instead of standing his ground, he crept towards a table, and slowly reached for the large egg. 'Feasts, tonight,' he thought. He grasped the egg, and, as soon as this victory had washed upon him, as soon as he'd let his guard down, he met eyes with the merchant. \"Hey!\" he yelled. The boy darted for home. He put the egg in a large pot. \"Please, don't burn the house.\" he prayed. The egg cracked, and instead of food, he saw a bird. When he'd pulled the thing out, he saw that it had back paws. and wings-\n\n-..bird wings. He looked at the creature and looked at the sky. \"I have been sent a blessing, far greater than food.\" He hid the creature in his home. If he was caught, he'd not make it. But he was willing to risk it, for this small gift, this birdlike angel. \"You're not the brightest thing. But a blessing, still.\" And that, was how the little boy, had found his Birdbrain Angel."},"xjjgC#cUwvX,UjrhVWG4":{"blockId":null,"x":-2206.2934780268065,"y":547.5555555555583,"width":443.55560302734375,"height":736.8888854980469,"minimized":false,"text":"@AbsolPip \nBirdbrain Angel Entry:\nThe night had fallen, this life was supposed to be filled with love, life, and light… her mother had said ‘life must be given not taken,’ but… She had to… she needed to… The cold, dead, lifeless body still oozed with warm blood, staining her pale feathers and talons. What. Had. She. Done… life was going to be different now, she knew it would be, as her eyes still lay on the bloody body.\nHer mind echoed with her mothers words ‘birdbrain, don’t be a bird brain we don’t hurt… or your a demon,” she’d shiver, what would happen now?"}},"currentCostume":2,"costumes":[{"name":"Lovebug","bitmapResolution":2,"dataFormat":"png","assetId":"89427612884c91b5338024cab68342b3","md5ext":"89427612884c91b5338024cab68342b3.png","rotationCenterX":199,"rotationCenterY":282},{"name":"costume3","bitmapResolution":2,"dataFormat":"png","assetId":"a3079b99b75ce69df5d9ffa94e94036c","md5ext":"a3079b99b75ce69df5d9ffa94e94036c.png","rotationCenterX":203,"rotationCenterY":248},{"name":"costume4","bitmapResolution":2,"dataFormat":"png","assetId":"dac999e5f0b2cda4d4d8543e08908b01","md5ext":"