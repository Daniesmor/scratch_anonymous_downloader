ite ih ako ostane vremena po istom principu kao i voće. \nLik će izgovoriti poruku ukoliko dodiruje obe bubice istovremeno, a ako dodiruje samo jednu neće se dogoditi ništa. \n\n"},"zR-Kr6@Ve(9{3m,hXcX*":{"blockId":"l6FX3/mwHSfrEq%!;^_z","x":1058.4612268518517,"y":1848.5555555555557,"width":208.888916015625,"height":232.59259033203125,"minimized":false,"text":"\n6. \n\nAko dodirne obe bubice istovremeno, obratiće im se obema, a ako dodirne jednu ili drugu onda će im se obratiti ponaosob. \n"}},"currentCostume":0,"costumes":[{"name":"monkey-a","bitmapResolution":1,"dataFormat":"svg","assetId":"254926ee81bfa82f2db7009a80635061","md5ext":"254926ee81bfa82f2db7009a80635061.svg","rotationCenterX":68,"rotationCenterY":99},{"name":"monkey-b","bitmapResolution":1,"dataFormat":"svg","assetId":"de0405b0576ade1282bdfcd198922baa","md5ext":"de0405b0576ade1282bdfcd198922baa.svg","rotationCenterX":68,"rotationCenterY":99},{"name":"monkey-c","bitmapResolution":1,"dataFormat":"svg","assetId":"ec6d62f0ff64bb5440ffdc662b6e46fa","md5ext":"ec6d62f0ff64bb5440ffdc662b6e46fa.svg","rotationCenterX":68,"rotationCenterY":99}],"sounds":[{"name":"Chee Chee","assetId":"25f4826cdd61e0a1c623ec2324c16ca0","dataFormat":"wav","format":"","rate":48000,"sampleCount":75232,"md5ext":"25f4826cdd61e0a1c623ec2324c16ca0.wav"},{"name":"Chomp","assetId":"0b1e3033140d094563248e61de4039e5","dataFormat":"wav","format":"","rate":48000,"sampleCount":12678,"md5ext":"0b1e3033140d094563248e61de4039e5.wav"}],"volume":100,"layerOrder":11,"visible":true,"x":-190,"y":-110,"size":80,"direction":90,"draggable":false,"rotationStyle":"left-right"},{"isStage":false,"name":"Orange","variables":{},"lists":{},"broadcasts":{},"blocks":{"{P@uk)yiIdRa+Czz__J[":{"opcode":"event_whenflagclicked","next":"rf^q;x.kbSo2=j;dWnih","parent":null,"inputs":{},"fields":{},"shadow":false,"topLevel":true,"x":273,"y":261},"rf^q;x.kbSo2=j;dWnih":{"opcode":"motion_gotoxy","next":null,"parent":"{P@uk)yiIdRa+Czz__J[","inputs":{"X":[1,[4,"-160"]],"Y":[1