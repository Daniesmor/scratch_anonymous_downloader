iate!\n⚠️ 4. Don't add or remove anyone from the breaking-rules list without RDash75's permission.\n⚠️ 5. Don't delete any of these rules or instructions or completely change the project's title.\n6. Don't delete or destructively modify anything you didn't make, unless to fix glitches, errors, or rule-breaks or to remove unused scripts.\n❓ 7. Please don't make your characters overly large; that'd waste space that could be used for more characters. It's recommended you keep larger characters nearer to the top or to the back layer so they block less ground.\n8. Please refrain from add any characters that are static images, even if you animate them, background included or not (EG: A PNG or JPEG of a Minecraft mob or some other thing).\n9. Please don't add an intro or outro on this project or else it will slow down this project!\n❓ 10. Anyone on the breaking-rules list can add new rules if needed. Remember to add them to both the thumbnail's RULE RECAP comment and the Instructions."}},"currentCostume":0,"costumes":[{"name":"Thumbnail","bitmapResolution":1,"dataFormat":"svg","assetId":"6ae0f25a7bdf8711381d265532336ddd","md5ext":"6ae0f25a7bdf8711381d265532336ddd.svg","rotationCenterX":251.42461889648433,"rotationCenterY":-50.47929469181062}],"sounds":[],"volume":100,"layerOrder":7,"visible":true,"x":0,"y":0,"size":100,"direction":90,"draggable":false,"rotationStyle":"all around"},{"isStage":false,"name":"Balloon1","variables":{},"lists":{},"broadcasts":{},"blocks":{"4Kf_oz=LzuWb04#oBED?":{"opcode":"event_whenflagclicked","next":",FH1fxqBv)7au*VgdPl)","parent":null,"inputs":{},"fields":{},"shadow":false,"topLevel":true,"x":91,"y":190},",FH1fxqBv)7au*VgdPl)":{"opcode":"looks_hide","next":"j[|aOJ~:T2u7EES!?h==","parent":"4Kf_oz=LzuWb04#oBED?","inputs":{},"fields":{},"shadow":false,"topLevel":false},"j[|aOJ~:T2u7EES!?h==":{"opcode":"control_wait","next":"xcp~bRz%=kZVP0XDWJ|@","parent":",FH1fxqBv)7au*VgdPl)","inputs":{"DURATION":[1,[5,"1"]]},"fields":{},"shadow":false,"topLeve