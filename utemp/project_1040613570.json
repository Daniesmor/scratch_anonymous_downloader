:90,"draggable":false,"rotationStyle":"all around"},{"isStage":false,"name":"REFS","variables":{},"lists":{},"broadcasts":{},"blocks":{},"comments":{},"currentCostume":0,"costumes":[{"name":"Bluestar","bitmapResolution":2,"dataFormat":"png","assetId":"590c22b433be6df54c864da7de9dfc24","md5ext":"590c22b433be6df54c864da7de9dfc24.png","rotationCenterX":480,"rotationCenterY":360},{"name":"Snowfur","bitmapResolution":2,"dataFormat":"png","assetId":"82e2408ea3b380fed118c9ea69072041","md5ext":"82e2408ea3b380fed118c9ea69072041.png","rotationCenterX":480,"rotationCenterY":360},{"name":"Oakheart","bitmapResolution":2,"dataFormat":"png","assetId":"35fd04dda628b6c71b9f8faa8d174fd3","md5ext":"35fd04dda628b6c71b9f8faa8d174fd3.png","rotationCenterX":480,"rotationCenterY":360},{"name":"Fireheart","bitmapResolution":2,"dataFormat":"png","assetId":"3ee3691075dee95001619742ea64d941","md5ext":"3ee3691075dee95001619742ea64d941.png","rotationCenterX":480,"rotationCenterY":360},{"name":"Mistykit","bitmapResolution":2,"dataFormat":"png","assetId":"70af1ccb7f1a5415ea3c66de620b28c4","md5ext":"70af1ccb7f1a5415ea3c66de620b28c4.png","rotationCenterX":480,"rotationCenterY":360},{"name":"Stonekit","bitmapResolution":2,"dataFormat":"png","assetId":"517aa67d0e9f524139667da97663d7ae","md5ext":"517aa67d0e9f524139667da97663d7ae.png","rotationCenterX":480,"rotationCenterY":360},{"name":"Mosskit","bitmapResolution":2,"dataFormat":"png","assetId":"8a285ab5c5af7f5811a5bda26f60b059","md5ext":"8a285ab5c5af7f5811a5bda26f60b059.png","rotationCenterX":480,"rotationCenterY":360},{"name":"Moonflower","bitmapResolution":2,"dataFormat":"png","assetId":"b1d4f16214c70c27569731041cbb16f9","md5ext":"b1d4f16214c70c27569731041cbb16f9.png","rotationCenterX":480,"rotationCenterY":360},{"name":"Goosefeather","bitmapResolution":2,"dataFormat":"png","assetId":"8d995e1f76d798f54a937d637b1bbc89","md5ext":"8d995e1f76d798f54a937d637b1bbc89.png","rotationCenterX":480,"rotationCenterY":360},{"name":"IMG_8584","bitmapResolution":2,"dataFormat":"png","assetId":"c5c8b7332f22fe1e38ddf84385f52e03","md5ext":"c5c8b7332f22fe1e38ddf84385f52e03.png","rotationCenterX":480,"rotationCenterY":360},{"name":"Fourtrees","bitmapResolution":2,"dataFormat":"png","assetId":"3656721914343c12c47a208507287867","md5ext":"3656721914343c12c47a208507287867.png","rotationCenterX":480,"rotationCenterY":327},{"name":"costume1","bitmapResolution":2,"dataFormat":"png","assetId":"81c3b01b98e02635753ecacd111b2919","md5ext":"81c3b01b98e02635753ecacd111b2919.png","rotationCenterX":297,"rotationCenterY":121}],"sounds":[{"name":"pop","assetId":"83a9787d4cb6f3b7632b4ddfebf74367","dataFormat":"wav","format":"","rate":48000,"sampleCount":1123,"md5ext":"83a9787d4cb6f3b7632b4ddfebf74367.wav"}],"volume":100,"layerOrder":2,"visible":false,"x":0,"y":0,"size":100,"direction":90,"draggable":false,"rotationStyle":"all around"},{"isStage":false,"name":"Script","variables":{},"lists":{},"broadcasts":{},"blocks":{"`4M.6{6t3tc@|t~zio=9":{"opcode":"event_whenflagclicked","next":null,"parent":null,"inputs":{},"fields":{},"shadow":false,"topLevel":true,"x":26,"y":244,"comment":"[%C|?e4^c-/sUL=1TW(%"}},"comments":{"[%C|?e4^c-/sUL=1TW(%":{"blockId":"`4M.6{6t3tc@|t~zio=9","x":207.29481435705117,"y":252.2962962962971,"width":858.066650390625,"height":2610.9332885742188,"minimized":false,"text":"SCRIPT\n\nIntro\nIt shows Bluekit waking up in the nursery in a slight close up on her, and then turns into her view looking at the exit, with the words “YOUTH- A BLUESTAR MAP”\n\nPart 1\nBluekit runs outside with Snowkit, leaping onto her and rolling over with her.\n\nPart 2\nBluekit looks around the camp as she pins down Snowkit, and she gasps when she sees it\n\nPart 3\nSnowkit gets up, and the two kits run around the camp. Then they disappear behind a tree, and thats when the next part starts.\n\nPart 4\nWhen the tree is gone, it reveals Snowpaw and Bluepaw laughing together, then Bluepaw with Sparrowpelt(during the battle), and pricks her ears when she hears Moonflower, turns and runs down the slope.\n\nPart 5\nBluepaw is horrified, with Moonflower’s body in front of her.\n\nPart 6\nThis scene shows Bluepaw and Snowpaw together, their noses in Moonflower’s fur for the vigil. Moonflower fades into view behind them, a sad expression on her face.\n\nPart 7\nBluepaw is hissing at Goosefeather in his den, but then his eyes light up and he tells her the prophecy. “You will be a fire that will blaze through the forest, but who will be destroyed by water.”\n\nPart 8\nBluefur’s and Snowfur’s names are chanted, and they smile at eachother.\n\nPart 9\nBluefur tells Snowfur about the prophecy Goosefeather told her, and stomps away when Snowfur says she dosent believe it. Snowfur looks sad. (Duh :p)\n\nPart 10\nBluefur is chatting and laughing with Crookedjaw, a riverclan warrior, at the gathering. She points at his tail(“Cause your tails still straight!”), and he smiles.\n\nPart 11\nBluefur watches as Pinestar puts his nose on the moonstone and drifts to sleep, lip-syncing \"we are the wild youth, \" with worry on her face.(The part when it says \"we are the reckless\", there is no lip-syncing. This is the time for animation.)\n\nPart 12\nBluefur and Rosetail are talking, the two best friends taking a walk in the forest. Rosetail lip-syncs \"our futures.\"(No lip-syncing before \"our futures\", just animation.)\n\nPart 13\nBluefur and Oakheart are in Fourtrees, climbing and laughing. When they sit together on a branch high up, Bluefur looks away and lip syncs \"reveal the truth.\"(the part when the song says \"one day, we'll\", that's time for animating, Bluefur is not lip-syncing.)\n\nPart 14\nBluestar cries as Snowfur is hit by the monster, blood trickling from her mouth.\n\nPart 15\nBluefur names her kits(Mistykit, Stonekit, and Mosskit), and Thrushpelt stares proudly at them.\n\nPart 16\nGoosefeather passes by the nursery, shooting Bluefur a look, and Bluefur lip-syncs \"they are dead, and they are gone.\" (during the part when the song says \"cause most of our feelings\", no one is lip-syncing yet, that's the time for animation.)\n\nPart 17\nBluefur takes her kits out in the forest during leaf-bare to bring them to Riverclan.\n\nPart 18\nBluefur cries into Mosskit as she lays on the snow, lip-syncing \"It was a flood that wrecked this home.\" Mistykit and Stonekit behind Bluefur. \n\nPart 19\nBluefur reaches sunningrocks, and gives the kits to Oakheart, crying. Goosefeather slowly fades into view behind her(he's not really there, it's her remebering him), and Bluefur lip-syncs \"and you caused it.\"\n\nPart 20\nBluefur yowls from the nursery, “my kits! Where are my kits?” Cats come into the nursery and find a huge hole, and Bluefur crying frantically.\n\nPart 21\nShe travels to the moonstone and becomes leader. One white star transition when she touches the moonstone later, she tells Graypaw that she wants him to spy on Rusty.\n\nPart 22\nShe watches as Whitestorm and Lionheart lead Rusty into the camp, watching in her den, a dim look on her face as she lip-syncs \"I'm just a silhouette.\" (No lip-syncing before \"I'm just a silhouette\", just animation.)\n\nPart 23\nWhen Bluestar is on the rock, Ravenpaw yowls Redtail is dead, and Bluestar's eyes widen with a gasp, and quietly lip-syncs \"You'll soon forget.\" (No lip-syncing before \"You'll soon forget\", just animation.)\n\nPart 24\nBluestar cries in her den, with Oakheart’s ghost slowly fading into view, curling next to her, behind her.\n\nPart 25\nShe trains with Firepaw, instructing him and showing him how to fight.\n\nPart 26\nShe makes Firepaw and Graypaw into warriors, Fireheart and Graystripe. She smiles, and then turns her head a bit and frowns when \"when you broke my chest\" sounds.\n\nPart 27\nBluestar is on the floor, with Tigerclaw pinning her down, scratches everywhere. When \"in love” is heard, the scene changes to Fireheart growling and leaping at Tigerclaw, no transition. Bluestar watches weakly and cries at “then you are the lucky one.”\n\nPart 28\nBluestar is on the rock, traumatized, with Fireheart exiling Tigerclaw, the past-kittypet lip-syncing \"bitter over someone\". (No lip-syncing before \"Bitter over someone\", just animation.)\n\nPart 29\nBluestar is yowling at Fireheart, explaining him about her kits, Mistykit, Stonekit, and Mosskit.\n\nPart 30\nBluestar hits the dog off of Fireheart, falling off the gorge. She splashes into the water, smiling when she sees Fireheart.\n\nPart 31\nBluestar is dragged out of the water by her kits, Mistyfoot and Stonefur, and explains how she loves them and how she’s sorry.\n\nPart 32\nMistyfoot and Stonefur forgive her. Fireheart begs her to stay alive, and then he turns to Tigerstar, who is looking at them not too far away, and lip-syncs \"and you caused it.\" Bluestar falls onto the ground. The last scene is her eyes closing, and Fireheart’s blurry image crying.\n\nOUTRO\nShe wakes up, and Oakheart, Mosskit, Moonflower, Snowfur, and Thrushpelt are around her, and she smiles. She gets up, and purrs as they press against her and greet her. [Then screen fades to black, I’ll handle the credits]"}},"currentCostume":0,"costumes":[{"name":"costume1","bitmapResolution":1,"dataFormat":"svg","assetId":"3339a2953a3bf62bb80e54ff575dbced","md5ext":"3339a2953a3bf62bb80e54ff575dbced.svg","rotationCenterX":0,"rotationCenterY":0}],"sounds":[{"name":"pop","assetId":"83a9787d4cb6f3b7632b4ddfebf74367","dataFormat":"wav","format":"","rate":48000,"sampleCount":1123,"md5ext":"83a9787d4cb6f3b7632b4ddfebf74367.wav"}],"volume":100,"layerOrder":3,"visible":true,"x":0,"y":0,"size":100,"direction":90,"draggable":false,"rotationStyle":"all around"}],"monitors":[{"id":"^tn_J7^q6Hv.Lv=nQHAf","mode":"default","opcode":"data_variable","params":{"VARIABLE":"Part"},"spriteName":null,"value":"Intro","width":0,"height":0,"x":333,"y":211,"visible":true,"sliderMin":0,"sliderMax":100,"isDiscrete":true}],"extensions":[],"meta":{"semver":"3.0.0","vm":"2.3.4","agent":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"}}