		{
			"objName": "Generator",
			"variables": [{
					"name": "spacePressed?",
					"value": 0,
					"isPersistent": false
				}],
			"scripts": [[10, 10, [["whenIReceive", "setupGeneral"], ["call", "Generate Name %n", ["randomFrom:to:", 1, 3]]]],
				[10,
					80,
					[["whenIReceive", "actionOne"],
						["doIfElse",
							["|", ["keyPressed:", "space"], ["&", ["touching:", "_mouse_"], ["mousePressed"]]],
							[["doIf",
									["=", ["readVariable", "spacePressed?"], "0"],
									[["call", "Generate Name %n", ["randomFrom:to:", 1, 3]],
										["setVar:to:", "spacePressed?", "1"],
										["setSizeTo:", 90]]]],
							[["setSizeTo:", 100], ["setVar:to:", "spacePressed?", 0]]]]],
				[10,
					354,
					[["procDef", "Generate Name %n", ["#"], [1], true],
						["doIf",
							["=", ["getParam", "#", "r"], "1"],
							[["doIfElse",
									["=", ["randomFrom:to:", 1, 2], "1"],
									[["setVar:to:", "Name", ["concatenate:with:", ["getLine:ofList:", "random", "Names"], ["getLine:ofList:", "random", "Endings"]]]],
									[["setVar:to:", "Name", ["getLine:ofList:", "random", "Names"]]]]]],
						["doIf",
							["=", ["getParam", "#", "r"], "2"],
							[["doIfElse",
									["=", ["randomFrom:to:", 1, 2], "1"],
									[["setVar:to:",
											"Name",
											["concatenate:with:", "The ", ["concatenate:with:", ["getLine:ofList:", "random", "adjectives"], ["getLine:ofList:", "random", "Endings"]]]]],
									[["setVar:to:",
											"Name",
											["concatenate:with:", "The ", ["concatenate:with:", ["getLine:ofList:", "random", "adjectives2"], ["getLine:ofList:", "random", "Endings2"]]]]]]]],
						["doIf",
							["=", ["getParam", "#", "r"], "3"],
							[["doIfElse",
									["=", ["getUserName"], ""],
									[["call", "Generate Name %n", ["randomFrom:to:", 1, 2]]],
									[["doIfElse",
											["=", ["randomFrom:to:", 1, 2], "1"],
											[["setVar:to:", "Name", ["concatenate:with:", ["concatenate:with:", ["getUserName"], "'s "], ["getLine:ofList:", "random", "Endings"]]]],
											[["setVar:to:",
													"Name",
													["concatenate:with:",
														["concatenate:with:", ["getUserName"], "'s "],
														["concatenate:with:", ["getLine:ofList:", "random", "adjectives"], ["getLine:ofList:", "random", "Endings"]]]]]]]]]]]]],
			"scriptComments": [[266, 44, 181, 39, false, 1, "Generates the first name"],
				[581, 119, 440, 227, true, 4, "This script is meant to handle \"button-clicking\"\r\rIn essence, clicking a button consists of (1) being near the button and (2) pressing down on the button [holding down the button doesn't count.] Pressing the space key is also implemented.\r\rTo translate this concept into code, you have to check that (1) the button sprite is touching the mouse pointer and that (2) the mouse is down [or space is pressed]. The \"spacePressed?\" variable is used to make sure that holding the button down isn't registered as continuous button presses, but rather as a single press.\r\rAnimation is also added to complement user interaction (i.e. the button reacts to being pressed.)"],
				[727.95, 385, 350, 321, true, 19, "This function generates names based on the \"#\" variable. This certainly isn't the only way to generate phrases, but I find it quite intuitive.\r\rIt works by selecting words that match from a series of lists.\r\r[# = 1] Names are unique and do not have an adjective added to them (e.g. \"SwirlSation\".) They may, however, include an ending (e.g. \"SwirlSation Ice Cream Shop\".)\r\r[# = 2] Adjectives match with endings (e.g. \"The Dreamy Creamery\".) Some adjectives are only matched with particular endings (e.g. \"The Waffle Spoon\" but not \"The Magic Spoon\".)\r\r[# = 3] Here, the name is personalized using the user's username in front of the generated name\/phrase (e.g. \"Kaj's Cheery Creamery\".)\r\rYou can create your own generator using this technique of combining randomly selected words from lists."],
				[296, 817, 125, 99, false, 56, "[Expand▾]\r\rhttp:\/\/wiki.scratch.mit.edu\/wiki\/Recursion"]],
