			"scriptComments": [[246, 116, 376, 161, true, 3, "Walk Speed - How fast the player walks\rGravity - The pull of grivity downwards\rJump Power - How high you jump\r\rspeed y - The current falling\/jumping speed\rfalling - The number of frames since we last touched the ground\rmy direction - The direction we are facing\rmy frame - the animation frame"],
				[482, 746, 264, 53, true, 101, "When not walking, return to standing frame."],
				[482, 802, 265, 97, true, 102, "Gravity makes us accellerate, it is added to the players speed each frame."],
				[482, 582, 262, 64, true, 90, "Show the player mask used for collision detection..."],
				[482, 900.5, 264, 93, true, 108, "You can only jump when you touched the floor within the last 4 frames..."],
				[482, 1141, 259, 44, true, 122, "Hide the player collision mask again."],
				[1217.15, 73.75, 279, 122, true, 44, "This custom block is set to 'run without screen refresh'. This means we can move the sprite sideways, check for collisions, and if it collides, move it upwards until it doesn't collide anymore... all without actually seeing it happen on the screen until it's all finished."],
				[1217.15, 210.75, 275, 62, true, 56, "Move up 1 pixel at a time until we are no longer colliding with the level."],
				[1217.15, 291.75, 278, 79, true, 66, "If we have moved up by 8 pixels and we are stil colliding then we must have hit a wall, and we move ourselves back to where we started from."],
				[1217.15, 426.25, 281, 88, true, 73, "If we did collide and were able to find a safe place to move to, then set our falling speed to 0 and set falling to 0 (we touched the ground)"],
				[1222.95, 595.7, 289, 134, true, 18, "This custom block is set to 'run without screen refresh'. This means we can move the sprite up or down, check for collisions, and if it collides, move it slowly backwards until it no longer collides... all without actually seeing it happen on the screen until it's all finished."],
				[1222.95, 731.7, 288, 97, true, 31, "If we moved and are now touching the level, move us back in the opersite direction one pixel at a time until we are no longer touching."],
				[1222.95, 881.7, 289, 99, true, 39, "If we collided then our new falling speed is 0.\rBut don't record us as having touched the ground unless we were moving downwards when we collided (otherwise is was a head collision!)"],
				[482, 1257, 255, 93, true, 128, "All the collectables are collected, on to next level!"]],
